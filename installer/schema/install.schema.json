{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PBB Support System installer config",
  "type": "object",
  "required": ["schema_version", "mode", "app", "database"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "mode": {
      "type": "string",
      "enum": ["fresh", "repair", "upgrade", "preflight"]
    },
    "kit": {
      "type": "object"
    },
    "app": {
      "type": "object",
      "required": ["install_path", "app_url"],
      "properties": {
        "install_path": {"type": "string", "minLength": 1},
        "public_path": {"type": "string"},
        "app_url": {"type": "string", "minLength": 1},
        "app_env": {"type": "string"},
        "app_debug": {"type": "boolean"}
      }
    },
    "database": {
      "type": "object",
      "required": ["host", "database", "username", "password"],
      "properties": {
        "driver": {"type": "string", "default": "mysql"},
        "host": {"type": "string", "minLength": 1},
        "port": {"type": ["integer", "string"], "default": 3306},
        "database": {"type": "string", "minLength": 1},
        "username": {"type": "string", "minLength": 1},
        "password": {"type": "string"}
      }
    },
    "admin": {
      "type": "object",
      "properties": {
        "strategy": {"type": "string", "enum": ["create_if_missing", "skip"]},
        "name": {"type": "string"},
        "email": {"type": "string"},
        "password": {"type": "string"},
        "must_change_password": {"type": "boolean"},
        "overwrite_existing": {"type": "boolean"}
      }
    },
    "dependencies": {
      "type": "object"
    },
    "options": {
      "type": "object",
      "properties": {
        "database_setup": {
          "type": "string",
          "enum": ["baseline_schema", "versioned_migrations"],
          "default": "baseline_schema"
        },
        "run_migrations": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
